# Copy to .env and fill in your own values: cp .env.example .env
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Celery broker
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
# True = run tasks inline without RabbitMQ (local dev only)
CELERY_TASK_ALWAYS_EAGER=False

# PostgreSQL (leave POSTGRES_DB empty to use SQLite locally)
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
